# Local demonstration only. Replace passwords for a shared deployment.
DB_PASSWORD=local-demo-password
MYSQL_ROOT_PASSWORD=local-root-password
APP_ORIGIN=http://localhost:3000
FRONTEND_PORT=3000
# If FRONTEND_PORT changes, update APP_ORIGIN to the same browser origin.
# Keep false for local HTTP. Set true only behind a working HTTPS entry.
COOKIE_SECURE=false
